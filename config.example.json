{
  "http": {
    "transport": "streamable-http",
    "host": "127.0.0.1",
    "port": 8765,
    "path": "/mcp",
    "public_base_url": "",
    "access_token_env": "CARBON_LENS_HTTP_ACCESS_TOKEN",
    "allowed_hosts": ["127.0.0.1:*", "localhost:*", "[::1]:*"],
    "allowed_origins": ["http://127.0.0.1:*", "http://localhost:*", "http://[::1]:*"]
  },
  "connections": {
    "carbon-prod": {
      "carbon_transport": "beeline",
      "connection_mode": "ssh",
      "ssh_config": {
        "hostname": "carbon-host.example.internal",
        "port": 22,
        "username": "carbon_ssh_user",
        "password_env": "CARBON_LENS_SSH_PASSWORD",
        "known_hosts": "keys/known_hosts"
      },
      "auto_save_host_key": true,
      "export_temp_ttl_seconds": 1800,
      "run_as_user": "root",
      "root_password_env": "CARBON_LENS_ROOT_PASSWORD",
      "env_script": "/opt/client/bigdata_env",
      "beeline_path": "/opt/client/Fiber/bin/fiber-beeline",
      "beeline_connection": "Carbon_Query_XDR",
      "principal": "carbon_user@EXAMPLE.REALM",
      "keytab": "/path/to/carbon_user.keytab",
      "remote_tmp_dir": "/tmp",
      "export_dir": "exports",
      "timeout_seconds": 600,
      "max_rows": 1000000,
      "max_output_bytes": 104857600,
      "write_workspace": {
        "enabled": false,
        "schema": "carbon_lens",
        "table_prefix": "cl_tmp_"
      }
    }
  }
}
